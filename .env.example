# AgentForge Interview local configuration
# Copy this file to .env and replace placeholders. Never commit .env.

# Default OpenAI-compatible provider (DashScope)
AI_BAILIAN_API_KEY=your_dashscope_api_key_here
AI_MODEL=qwen3.5-flash

# Provider API key encryption (use a long random value and keep it stable)
APP_AI_CONFIG_ENCRYPTION_KEY=replace_with_a_long_random_secret

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentforge_interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_database_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RustFS / S3-compatible storage for local development
RUSTFS_ACCESS_KEY=change_me_storage_access
RUSTFS_SECRET_KEY=change_me_storage_secret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=change_me_storage_access
APP_STORAGE_SECRET_KEY=change_me_storage_secret
APP_STORAGE_BUCKET=agentforge-interview
APP_STORAGE_REGION=us-east-1

# Optional OpenAI-compatible providers
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# Optional voice/runtime tuning
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000
# APP_VOICE_OPENING_AUDIO_WARMUP_ENABLED=false
